{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForkHub",
  "version": "0.1.0",
  "identifier": "com.forkhub.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../desktop-ui/dist",
    "beforeDevCommand": "bash scripts/build-sidecar.sh && pnpm --filter @forkhub/desktop-ui dev",
    "beforeBuildCommand": "bash scripts/build-desktop.sh"
  },
  "app": {
    "windows": [
      {
        "title": "ForkHub",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "externalBin": ["binaries/fh"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Keep your fork's patches while staying up-to-date with upstream",
    "longDescription": "ForkHub desktop: every fh CLI feature behind a native GUI. Declare each local change once as an intent, and an AI coding agent re-derives it against every new upstream release."
  }
}
