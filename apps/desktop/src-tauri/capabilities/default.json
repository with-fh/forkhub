{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the ForkHub main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "args": true, "name": "binaries/fh", "sidecar": true }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "args": true, "name": "binaries/fh", "sidecar": true }]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "dialog:allow-open"
  ]
}
