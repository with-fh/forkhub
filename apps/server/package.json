{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@orpc/openapi": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "@orpc/zod": "^1.14.6",
    "@forkhub/api": "workspace:*",
    "@forkhub/db": "workspace:*",
    "@forkhub/env": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.29",
    "evlog": "^2.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@forkhub/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
