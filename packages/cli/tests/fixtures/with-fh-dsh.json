{
  "target": "github.com/deepseek-ai/deepseek-harness",
  "description": "DeepSeek Harness Desktop x ForkHub update channel for Windows + macOS + Linux (unified updater releases v<base>.with-fh.<date>.<n>; 280k-star upstream)",
  "bin": "dsh",
  "defaultChannel": "stable",
  "asset": "deepseek-harness-{version}-win-x64-unsigned.exe",
  "assets": {
    "win32-x64": "deepseek-harness-{version}-win-x64-unsigned.exe",
    "darwin-arm64": "deepseek-harness-{version}-mac-arm64-unsigned.dmg",
    "linux-x64": "deepseek-harness-{version}-linux-x86_64-unsigned.AppImage"
  },
  "binPaths": {
    "win32-x64": "{asset}",
    "darwin-arm64": "{asset}",
    "linux-x64": "{asset}"
  },
  "extract": "none",
  "platforms": ["win32-x64", "darwin-arm64", "linux-x64"],
  "channels": {
    "stable": {
      "tagMatch": "^v[0-9]+\\.[0-9]+\\.[0-9]+.*\\.with-fh\\.[0-9]{8}\\.[0-9]+$"
    }
  }
}
