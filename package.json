{
  "name": "forkhub-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @forkhub/db",
    "db:studio": "turbo run db:studio -F @forkhub/db",
    "db:generate": "turbo run db:generate -F @forkhub/db",
    "db:migrate": "turbo run db:migrate -F @forkhub/db",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@forkhub/env": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@forkhub/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.10.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.3",
  "bin": {
    "fh": "./packages/cli/bin/fh.js",
    "forkhub": "./packages/cli/bin/fh.js"
  }
}
